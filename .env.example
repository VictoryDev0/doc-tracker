# --- core ---------------------------------------------------------------
# Admin key for /dash and /admin/* (passed as ?key=...). Use a long random string.
TRACKER_KEY=change-me-to-a-long-random-string
# Public base URL used when minting share links.
TRACKER_BASE_URL=https://docs.example.com
TRACKER_PORT=8092
TRACKER_BIND=127.0.0.1
# TRACKER_DB=./data/tracker.db
# TRACKER_DOCS=./data/docs
TRACKER_BRAND=Doc Tracker

# --- questionnaires -----------------------------------------------------
# slug:file.html:Label entries separated by ";". The slug is the access key in /form?k=<slug>.
TRACKER_FORMS=demo:sample_form.html:Sample questionnaire
# TRACKER_FORMS_DIR=./examples

# --- push notifications (all optional) -----------------------------------
# all = every real open, named = only named recipient links, off = dashboard only
TRACKER_NOTIFY_OPENS=all
# ntfy: public server or self-hosted. Pick an unguessable topic name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via SMTP (465 = implicit TLS, anything else = STARTTLS)
TRACKER_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- geo lookup (optional) ------------------------------------------------
# Without a token the free ipwho.is endpoint is used.
IPINFO_TOKEN=
